# Copy to .env for docker compose. Replace every secret before any shared or cloud deployment.
POSTGRES_PASSWORD=erp_owner_dev_password
APP_DB_PASSWORD=erp_app_dev_password
AI_SERVICE_TOKEN=change-me-to-a-long-random-secret-at-least-32-chars
WEB_ORIGIN=http://localhost:3000
# Set to true behind HTTPS.
COOKIE_SECURE=false
# Load synthetic demo schools on first start.
SEED_DEMO=true
# LLM provider key for the AI phase (optional for now).
LLM_API_KEY=
