# Runtime role: restricted, no BYPASSRLS. Row-Level Security always applies.
DATABASE_URL=postgresql://erp_app:erp_app_dev_password@localhost:5432/school_erp
# Schema owner: used only by `prisma migrate`.
MIGRATION_DATABASE_URL=postgresql://erp_owner:erp_owner_dev_password@localhost:5432/school_erp
REDIS_URL=redis://localhost:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
PLATFORM_SESSION_TTL_HOURS=4
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=10
ENABLE_JOBS=true
# COOKIE_SECURE defaults to true when NODE_ENV=production
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-to-a-long-random-secret-at-least-32-chars
