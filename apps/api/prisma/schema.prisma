// School ERP – core data model (foundation phase)
//
// Conventions
// - Every primary key is a UUID generated by PostgreSQL.
// - Every school-owned table carries `school_id`. Row-Level Security policies
//   (see migrations) restrict rows to `app.current_school_id`, which the API
//   sets per transaction from the authenticated session. Never from the client.
// - Platform tables (schools, platform_admins, platform_sessions) are not
//   tenant-scoped and are only reachable through the platform module.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Platform ─────────────────────────────

enum Board {
  CBSE
  ICSE
  STATE_BOARD
  IB
  CAMBRIDGE
  CUSTOM
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model School {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String       @unique // short login code, e.g. "DPSBLR"
  name      String
  board     Board
  boardName String?      @map("board_name") // e.g. "Karnataka SSLC" for state boards
  city      String?
  state     String?
  country   String       @default("IN")
  timezone  String       @default("Asia/Kolkata")
  locale    String       @default("en-IN")
  currency  String       @default("INR")
  status    SchoolStatus @default(ACTIVE)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  roles               Role[]
  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  sessions            Session[]
  auditLogs           AuditLog[]
  academicYears       AcademicYear[]
  grades              Grade[]
  sections            Section[]
  departments         Department[]
  subjects            Subject[]
  gradeSubjects       GradeSubject[]
  gradingScales       GradingScale[]
  gradingBands        GradingBand[]
  examCategories      ExamCategory[]
  staff               StaffProfile[]
  teachingAssignments TeachingAssignment[]
  students            Student[]
  enrollments         Enrollment[]
  guardians           Guardian[]
  studentGuardians    StudentGuardian[]

  @@map("schools")
}

model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions PlatformSession[]

  @@map("platform_admins")
}

model PlatformSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformAdminId String    @map("platform_admin_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@map("platform_sessions")
}

// ─────────────────────── Identity & access (tenant) ───────────────────────

enum UserType {
  STAFF
  STUDENT
  GUARDIAN
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String     @map("school_id") @db.Uuid
  email            String // stored lower-case
  phone            String?
  fullName         String     @map("full_name")
  passwordHash     String?    @map("password_hash")
  userType         UserType   @map("user_type")
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles        UserRole[]
  sessions     Session[]
  staffProfile StaffProfile?
  student      Student?
  guardian     Guardian?

  @@unique([schoolId, email])
  @@unique([id, schoolId])
  @@index([schoolId, userType])
  @@map("users")
}

// Permission scope used for record-level (ABAC) checks.
//   ALL      – every record in the school
//   ASSIGNED – records linked to the user's teaching/department assignments
//   LINKED   – records of the guardian's linked children
//   OWN      – the user's own record only
enum PermissionScope {
  ALL
  ASSIGNED
  LINKED
  OWN
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  key         String // e.g. SCHOOL_ADMIN, PRINCIPAL, TEACHER
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([schoolId, key])
  @@unique([id, schoolId])
  @@map("roles")
}

model RolePermission {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String          @map("school_id") @db.Uuid
  roleId     String          @map("role_id") @db.Uuid
  permission String // "<module>:<action>", see permissions catalog in code
  scope      PermissionScope @default(ALL)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([schoolId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([schoolId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") // SHA-256 of the opaque token; raw token never stored
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, userId])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String // e.g. "student.create"
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────── Academic structure (tenant) ───────────────────────

model AcademicYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String // e.g. "2026-27"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections            Section[]
  gradeSubjects       GradeSubject[]
  teachingAssignments TeachingAssignment[]
  enrollments         Enrollment[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@map("academic_years")
}

// A class / grade level as the school names it: "LKG", "Class 10", "Grade 5", "Year 11".
model Grade {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  code      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections      Section[]
  gradeSubjects GradeSubject[]

  @@unique([schoolId, code])
  @@unique([id, schoolId])
  @@map("grades")
}

model Section {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  gradeId        String   @map("grade_id") @db.Uuid
  name           String // "A", "Rose", ...
  capacity       Int?
  room           String?
  classTeacherId String?  @map("class_teacher_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear         @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  grade               Grade                @relation(fields: [gradeId, schoolId], references: [id, schoolId], onDelete: Cascade)
  classTeacher        StaffProfile?        @relation("ClassTeacher", fields: [classTeacherId, schoolId], references: [id, schoolId], onDelete: NoAction)
  teachingAssignments TeachingAssignment[]
  enrollments         Enrollment[]

  @@unique([academicYearId, gradeId, name])
  @@unique([id, schoolId])
  @@index([schoolId, academicYearId])
  @@map("sections")
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  headId    String?  @map("head_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  head     StaffProfile?  @relation("DepartmentHead", fields: [headId, schoolId], references: [id, schoolId], onDelete: NoAction)
  members  StaffProfile[] @relation("DepartmentMembers")
  subjects Subject[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@map("departments")
}

enum SubjectType {
  CORE
  ELECTIVE
  LANGUAGE
  CO_SCHOLASTIC
  ACTIVITY
}

model Subject {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String      @map("school_id") @db.Uuid
  code         String
  name         String
  type         SubjectType @default(CORE)
  departmentId String?     @map("department_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId, schoolId], references: [id, schoolId], onDelete: NoAction)
  gradeSubjects       GradeSubject[]
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, code])
  @@unique([id, schoolId])
  @@map("subjects")
}

// Curriculum: which subjects a grade studies in a given academic year.
model GradeSubject {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  gradeId        String   @map("grade_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  isElective     Boolean  @default(false) @map("is_elective")
  periodsPerWeek Int?     @map("periods_per_week")
  gradingScaleId String?  @map("grading_scale_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  grade        Grade         @relation(fields: [gradeId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  gradingScale GradingScale? @relation(fields: [gradingScaleId, schoolId], references: [id, schoolId], onDelete: NoAction)

  @@unique([academicYearId, gradeId, subjectId])
  @@index([schoolId])
  @@map("grade_subjects")
}

enum GradingScaleType {
  PERCENTAGE_BANDS // e.g. CBSE A1..E, ICSE percentage bands
  GPA // e.g. 10-point / 4-point scales
  DESCRIPTIVE // e.g. "Excellent / Good / Needs improvement" for co-scholastic
}

model GradingScale {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  name        String
  type        GradingScaleType
  description String?
  isDefault   Boolean          @default(false) @map("is_default")
  passPercent Decimal          @default(33) @map("pass_percent") @db.Decimal(5, 2)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bands         GradingBand[]
  gradeSubjects GradeSubject[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@map("grading_scales")
}

model GradingBand {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  gradingScaleId String   @map("grading_scale_id") @db.Uuid
  label          String // "A1", "Distinction", ...
  minPercent     Decimal  @map("min_percent") @db.Decimal(5, 2)
  maxPercent     Decimal  @map("max_percent") @db.Decimal(5, 2)
  gradePoint     Decimal? @map("grade_point") @db.Decimal(4, 2)
  remark         String?
  sortOrder      Int      @default(0) @map("sort_order")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradingScale GradingScale @relation(fields: [gradingScaleId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([gradingScaleId, label])
  @@index([schoolId])
  @@map("grading_bands")
}

// Assessment categories a school uses (Unit Test, Periodic Test, Half-Yearly,
// Internal Assessment, ...) with their weightage towards the final result.
model ExamCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  name            String
  code            String
  weightage       Decimal  @default(0) @db.Decimal(5, 2) // percent of final result
  defaultMaxMarks Int      @default(100) @map("default_max_marks")
  passingMarks    Int?     @map("passing_marks")
  isInternal      Boolean  @default(false) @map("is_internal")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@map("exam_categories")
}

// ───────────────────────── People (tenant) ─────────────────────────

enum StaffType {
  TEACHING
  NON_TEACHING
}

model StaffProfile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  employeeCode   String    @map("employee_code")
  designation    String
  staffType      StaffType @map("staff_type")
  departmentId   String?   @map("department_id") @db.Uuid
  qualifications String?
  dateOfJoining  DateTime? @map("date_of_joining") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  department          Department?          @relation("DepartmentMembers", fields: [departmentId, schoolId], references: [id, schoolId], onDelete: NoAction)
  headOfDepartments   Department[]         @relation("DepartmentHead")
  classTeacherOf      Section[]            @relation("ClassTeacher")
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, employeeCode])
  @@unique([id, schoolId])
  @@unique([userId, schoolId])
  @@map("staff_profiles")
}

// A subject teacher teaching a subject to a section in an academic year.
model TeachingAssignment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  staff        StaffProfile @relation(fields: [staffId, schoolId], references: [id, schoolId], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([sectionId, subjectId, staffId])
  @@index([schoolId, staffId])
  @@map("teaching_assignments")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

model Student {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String        @map("school_id") @db.Uuid
  userId          String?       @unique @map("user_id") @db.Uuid
  admissionNumber String        @map("admission_number")
  firstName       String        @map("first_name")
  lastName        String?       @map("last_name")
  dateOfBirth     DateTime      @map("date_of_birth") @db.Date
  gender          Gender
  bloodGroup      String?       @map("blood_group")
  admissionDate   DateTime      @map("admission_date") @db.Date
  status          StudentStatus @default(ACTIVE)
  addressLine1    String?       @map("address_line1")
  addressLine2    String?       @map("address_line2")
  city            String?
  state           String?
  postalCode      String?       @map("postal_code")
  photoKey        String?       @map("photo_key") // object-storage key, served via signed URL
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: NoAction)
  enrollments Enrollment[]
  guardians   StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@unique([userId, schoolId])
  @@unique([id, schoolId])
  @@index([schoolId, status])
  @@map("students")
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  DETAINED
  TRANSFERRED
  WITHDRAWN
}

model Enrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  rollNumber     Int?             @map("roll_number")
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId, sectionId])
  @@map("enrollments")
}

model Guardian {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  fullName   String   @map("full_name")
  phone      String
  email      String?
  occupation String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: NoAction)
  students StudentGuardian[]

  @@unique([id, schoolId])
  @@unique([userId, schoolId])
  @@index([schoolId, phone])
  @@map("guardians")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

model StudentGuardian {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String               @map("school_id") @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  guardianId   String               @map("guardian_id") @db.Uuid
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false) @map("is_primary")
  canPickup    Boolean              @default(true) @map("can_pickup")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([schoolId, guardianId])
  @@map("student_guardians")
}
